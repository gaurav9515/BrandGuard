# ==============================================================================
# BrandGuard Enterprise Governance Platform - Environment Variables
# ==============================================================================
# Copy this file to .env in your root or backend/ directory and customize values.
# NEVER commit your actual .env file or sensitive secrets to version control.

# ------------------------------------------------------------------------------
# 1. Django Core Security & Environment
# ------------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=django-insecure-replace-with-a-random-64-character-cryptographic-string
ALLOWED_HOSTS=localhost,127.0.0.1,brandguard.onrender.com,*.onrender.com
DJANGO_SETTINGS_MODULE=brandguard_core.settings
PYTHON_VERSION=3.12.3
BRANDGUARD_ENV=production

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# If DATABASE_URL is not set, BrandGuard falls back to SQLite (db.sqlite3).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Example for Render Managed PostgreSQL:
# DATABASE_URL=postgres://brandguard:secret@dpg-xxxx.render.com/brandguard_db
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS) & CSRF Trusted Origins
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://brandguard-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,https://brandguard-frontend.onrender.com,https://brandguard-backend.onrender.com

# ------------------------------------------------------------------------------
# 4. Background Job Runner & Render Execution Fallback
# ------------------------------------------------------------------------------
# In Render Free/Starter tiers, BrandGuard utilizes a built-in ThreadPoolExecutor
# running inside the web process with database-backed status tracking.
BRANDGUARD_MAX_JOB_THREADS=4

# Set to True only if Celery worker dyno and Redis broker are provisioned
ENABLE_CELERY_JOBS=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ------------------------------------------------------------------------------
# 5. Governance Telemetry & Engine Thresholds
# ------------------------------------------------------------------------------
# Minimum triggered rule occurrences required before computing ambiguity diagnosis (NEEDS_CLARIFICATION vs TRAINING_GAP)
BRANDGUARD_MIN_TRIGGERS=10

# Estimated minutes of manual compliance review saved per automated pre-flight audit
BRANDGUARD_MINUTES_PER_AUDIT=5

# CIELAB Delta-E color deviation threshold (Sharma et al. CIEDE2000 standard)
BRANDGUARD_COLOR_DELTA_THRESHOLD=4.0
BRANDGUARD_DEFAULT_COLOR_METRIC=CIEDE2000

# WCAG 2.1 AA text contrast ratio minimum standard
BRANDGUARD_WCAG_MIN_RATIO=4.5

# ------------------------------------------------------------------------------
# 6. Cryptographic Signatures & Verification
# ------------------------------------------------------------------------------
# Key used to calculate HMAC-SHA256 clearance receipts and Ed25519 metadata stamps
BRANDGUARD_SECRET_KEY=brandguard-hmac-seal-key-2026-production
ED25519_PRIVATE_KEY_HEX=

# ------------------------------------------------------------------------------
# 7. Render Keep-Alive & Health Monitoring
# ------------------------------------------------------------------------------
# Target public URL pinged by the GitHub Actions keepalive workflow to prevent 15m hibernation
RENDER_APP_URL=brandguard-backend.onrender.com

# ------------------------------------------------------------------------------
# 8. Email / SMTP Configuration (Optional - for Invites & Password Reset)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=governance@brandguard.io
